    "expo": "~57.0.21",
    "expo-asset": "~57.0.16",
    "expo-constants": "~57.0.17",
    "expo-font": "~57.0.0",
    "expo-image-picker": "~57.0.16",
    "expo-linear-gradient": "~57.0.1",
    "expo-speech": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.2.4",
    "eas-cli": "^23.2.0",
    "typescript": "~5.9.3"
