{
  "name": "kalakriti-artisan-mobile",
  "version": "1.0.0",
  "description": "AI-Driven Market Linkage & Smart Cataloging Mobile App for Marginalized Artisans (SIH26090)",
  "main": "index.js",
  "scripts": {
    "start": "expo start --go --lan --clear",
    "tunnel": "expo start --go --tunnel --clear",
