{
  "expo": {
    "name": "KalaSetu",
    "slug": "kalakriti-artisan-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "KalaSetu needs camera access to capture product photos for AI cataloging.",
        "NSPhotoLibraryUsageDescription": "KalaSetu needs photo gallery access to select craft photos."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#C85A2B"
      },
      "package": "com.sih2026.kalakriti",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "INTERNET"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-asset"
    ],
    "updates": {
      "enabled": false
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "extra": {
      "eas": {
        "projectId": "08d31522-4985-4efd-9bad-79aabd6bf908"
      }
    }
  }
}
